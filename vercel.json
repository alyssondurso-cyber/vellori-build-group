{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/services/",
      "destination": "/services.html"
    },
    {
      "source": "/stucco-boca-raton",
      "destination": "/stucco-boca-raton.html"
    },
    {
      "source": "/stucco-boca-raton/",
      "destination": "/stucco-boca-raton.html"
    },
    {
      "source": "/travertine-boca-raton",
      "destination": "/travertine-boca-raton.html"
    },
    {
      "source": "/travertine-boca-raton/",
      "destination": "/travertine-boca-raton.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
